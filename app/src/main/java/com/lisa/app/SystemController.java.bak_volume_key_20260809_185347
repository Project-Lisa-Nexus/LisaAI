package com.lisa.app;

import android.content.Context;
import android.media.AudioManager;
import android.provider.Settings;

public class SystemController {

    public static boolean regola(
            Context context,
            String tipo,
            String operazione,
            String valoreTesto) {

        if (context == null || tipo == null || operazione == null)
            return false;

        tipo = tipo.trim().toLowerCase();
        operazione = operazione.trim().toLowerCase();

        Integer valore = null;

        if (valoreTesto != null && !valoreTesto.trim().isEmpty()) {
            try {
                valore = Integer.parseInt(
                        valoreTesto.replace("%", "").trim()
                );
                valore = Math.max(0, Math.min(100, valore));
            } catch (Exception ignored) {
            }
        }

        if ("volume".equals(tipo)) {
            return regolaVolume(context, operazione, valore);
        }

        if ("luminosita".equals(tipo)
                || "luminosità".equals(tipo)
                || "brightness".equals(tipo)) {

            return regolaLuminosita(context, operazione, valore);
        }

        return false;
    }


    // ========================================================
    // VOLUME
    // ========================================================

    private static boolean regolaVolume(
            Context context,
            String operazione,
            Integer percentuale) {

        try {
            AudioManager audio =
                    (AudioManager) context.getSystemService(
                            Context.AUDIO_SERVICE
                    );

            if (audio == null)
                return false;

            int stream = AudioManager.STREAM_MUSIC;
            int massimo = audio.getStreamMaxVolume(stream);
            int corrente = audio.getStreamVolume(stream);

            int nuovo;

            if ("imposta".equals(operazione)) {

                if (percentuale == null)
                    return false;

                nuovo = Math.round(
                        massimo * (percentuale / 100f)
                );

            } else if ("aumenta".equals(operazione)) {

                if (percentuale == null) {
                    audio.adjustStreamVolume(
                            stream,
                            AudioManager.ADJUST_RAISE,
                            AudioManager.FLAG_SHOW_UI
                    );
                    return true;
                }

                // "aumenta del 20%" = aumenta il valore corrente del 20%
                nuovo = Math.round(
                        corrente * (1f + percentuale / 100f)
                );

            } else if ("diminuisci".equals(operazione)) {

                if (percentuale == null) {
                    audio.adjustStreamVolume(
                            stream,
                            AudioManager.ADJUST_LOWER,
                            AudioManager.FLAG_SHOW_UI
                    );
                    return true;
                }

                // "diminuisci del 20%" = riduce il valore corrente del 20%
                nuovo = Math.round(
                        corrente * (1f - percentuale / 100f)
                );

            } else {
                return false;
            }

            nuovo = Math.max(0, Math.min(massimo, nuovo));

            audio.setStreamVolume(
                    stream,
                    nuovo,
                    AudioManager.FLAG_SHOW_UI
            );

            return true;

        } catch (Exception e) {
            return false;
        }
    }


    // ========================================================
    // LUMINOSITA
    // ========================================================

    private static boolean regolaLuminosita(
            Context context,
            String operazione,
            Integer percentuale) {

        try {
            if (!Settings.System.canWrite(context))
                return false;

            int corrente = Settings.System.getInt(
                    context.getContentResolver(),
                    Settings.System.SCREEN_BRIGHTNESS
            );

            int nuovo;

            if ("imposta".equals(operazione)) {

                if (percentuale == null)
                    return false;

                nuovo = Math.round(
                        255f * (percentuale / 100f)
                );

            } else if ("aumenta".equals(operazione)) {

                if (percentuale == null) {
                    nuovo = corrente + 25;
                } else {
                    nuovo = Math.round(
                            corrente * (1f + percentuale / 100f)
                    );
                }

            } else if ("diminuisci".equals(operazione)) {

                if (percentuale == null) {
                    nuovo = corrente - 25;
                } else {
                    nuovo = Math.round(
                            corrente * (1f - percentuale / 100f)
                    );
                }

            } else {
                return false;
            }

            // Evitiamo schermo completamente nero.
            nuovo = Math.max(1, Math.min(255, nuovo));

            Settings.System.putInt(
                    context.getContentResolver(),
                    Settings.System.SCREEN_BRIGHTNESS_MODE,
                    Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL
            );

            return Settings.System.putInt(
                    context.getContentResolver(),
                    Settings.System.SCREEN_BRIGHTNESS,
                    nuovo
            );

        } catch (Exception e) {
            return false;
        }
    }
}

package com.lisa.app;

import android.Manifest;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.media.AudioFormat;
import android.media.AudioRecord;
import android.media.MediaRecorder;
import android.os.Build;
import android.os.IBinder;
import android.util.Log;

import com.k2fsa.sherpa.onnx.FeatureConfig;
import com.k2fsa.sherpa.onnx.KeywordSpotter;
import com.k2fsa.sherpa.onnx.KeywordSpotterConfig;
import com.k2fsa.sherpa.onnx.KeywordSpotterResult;
import com.k2fsa.sherpa.onnx.OnlineModelConfig;
import com.k2fsa.sherpa.onnx.OnlineStream;
import com.k2fsa.sherpa.onnx.OnlineTransducerModelConfig;

public class LisaVoiceService extends Service {

    private static final String TAG = "LisaWake";
    private static final String CHANNEL_ID = "LisaVoiceChannel";

    private static final int SAMPLE_RATE = 16000;
    private static final int FEATURE_DIM = 80;

    private volatile boolean attivo = false;

    private Thread audioThread;
    private AudioRecord audioRecord;

    private KeywordSpotter keywordSpotter;
    private OnlineStream stream;

    private long ultimoWake = 0L;

    @Override
    public void onCreate() {
        super.onCreate();

        creaCanaleNotifica();

        Log.i(TAG, "Lisa Voice Core creato");
    }

    @Override
    public int onStartCommand(
            Intent intent,
            int flags,
            int startId) {

        startForeground(
                1,
                creaNotifica("In attesa della parola \"Lisa\"")
        );

        if (!attivo) {
            avviaWakeWord();
        }

        return START_STICKY;
    }

    private void avviaWakeWord() {

        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO)
                != PackageManager.PERMISSION_GRANTED) {

            Log.e(TAG, "Permesso RECORD_AUDIO non concesso");
            return;
        }

        try {

            inizializzaSherpa();

            int minimo = AudioRecord.getMinBufferSize(
                    SAMPLE_RATE,
                    AudioFormat.CHANNEL_IN_MONO,
                    AudioFormat.ENCODING_PCM_16BIT
            );

            if (minimo <= 0) {
                throw new IllegalStateException(
                        "Buffer AudioRecord non valido: " + minimo
                );
            }

            int bufferBytes = Math.max(
                    minimo * 2,
                    3200
            );

            audioRecord = new AudioRecord(
                    MediaRecorder.AudioSource.VOICE_RECOGNITION,
                    SAMPLE_RATE,
                    AudioFormat.CHANNEL_IN_MONO,
                    AudioFormat.ENCODING_PCM_16BIT,
                    bufferBytes
            );

            if (audioRecord.getState()
                    != AudioRecord.STATE_INITIALIZED) {

                throw new IllegalStateException(
                        "AudioRecord non inizializzato"
                );
            }

            attivo = true;

            audioRecord.startRecording();

            audioThread = new Thread(
                    this::cicloAudio,
                    "Lisa-WakeWord"
            );

            audioThread.start();

            Log.i(TAG, "🟢 Wake word LISA in ascolto");

        } catch (Throwable errore) {

            Log.e(
                    TAG,
                    "Errore avvio wake-word",
                    errore
            );

            fermaWakeWord();
        }
    }

    private void inizializzaSherpa() {

        FeatureConfig feature = new FeatureConfig();

        feature.setSampleRate(SAMPLE_RATE);
        feature.setFeatureDim(FEATURE_DIM);

        OnlineTransducerModelConfig transducer =
                new OnlineTransducerModelConfig();

        transducer.setEncoder(
                "lisa_kws/encoder.onnx"
        );

        transducer.setDecoder(
                "lisa_kws/decoder.onnx"
        );

        transducer.setJoiner(
                "lisa_kws/joiner.onnx"
        );

        OnlineModelConfig modello =
                new OnlineModelConfig();

        modello.setTransducer(transducer);

        modello.setTokens(
                "lisa_kws/tokens.txt"
        );

        modello.setNumThreads(1);

        modello.setDebug(false);

        modello.setProvider("cpu");

        modello.setModelType("zipformer2");

        KeywordSpotterConfig config =
                new KeywordSpotterConfig();

        config.setFeatConfig(feature);

        config.setModelConfig(modello);

        config.setMaxActivePaths(4);

        config.setKeywordsFile(
                "lisa_kws/keywords.txt"
        );

        config.setKeywordsScore(1.5f);

        config.setKeywordsThreshold(0.25f);

        config.setNumTrailingBlanks(2);

        keywordSpotter = new KeywordSpotter(
                getAssets(),
                config
        );

        /*
         * Le keyword sono già dentro keywords.txt.
         * Stringa vuota = usa quel file.
         */
        stream = keywordSpotter.createStream("");

        Log.i(TAG, "Sherpa KWS inizializzato");
    }

    private void cicloAudio() {

        /*
         * 800 campioni = 50 ms a 16 kHz.
         * Buffer piccolo per mantenere bassa la latenza.
         */
        short[] pcm = new short[800];

        while (attivo) {

            try {

                int letti = audioRecord.read(
                        pcm,
                        0,
                        pcm.length
                );

                if (letti <= 0) {
                    continue;
                }

                float[] samples =
                        new float[letti];

                for (int i = 0; i < letti; i++) {
                    samples[i] =
                            pcm[i] / 32768.0f;
                }

                stream.acceptWaveform(
                        samples,
                        SAMPLE_RATE
                );

                while (keywordSpotter.isReady(stream)) {

                    keywordSpotter.decode(stream);

                    KeywordSpotterResult risultato =
                            keywordSpotter.getResult(stream);

                    if (risultato == null) {
                        continue;
                    }

                    String parola =
                            risultato.getKeyword();

                    if (parola != null
                            && !parola.trim().isEmpty()) {

                        keywordSpotter.reset(stream);

                        parolaRilevata(
                                parola.trim()
                        );
                    }
                }

            } catch (Throwable errore) {

                if (attivo) {
                    Log.e(
                            TAG,
                            "Errore durante ascolto",
                            errore
                    );
                }
            }
        }
    }

    private void parolaRilevata(
            String parola) {

        long adesso =
                System.currentTimeMillis();

        /*
         * Evita doppie attivazioni ravvicinate.
         */
        if (adesso - ultimoWake < 2500) {
            return;
        }

        ultimoWake = adesso;

        Log.i(
                TAG,
                "🟢 WAKE WORD RILEVATA: "
                        + parola
        );

        Intent evento =
                new Intent(
                        "com.lisa.app.WAKE_WORD_DETECTED"
                );

        evento.setPackage(
                getPackageName()
        );

        evento.putExtra(
                "keyword",
                parola
        );

        sendBroadcast(evento);

        /*
         * Per il primo test ci dà una conferma
         * immediata senza dover guardare Logcat.
         *
         * Nel prossimo passaggio questa frase
         * verrà sostituita direttamente
         * dall'ascolto del comando.
         */
        LisaSpeaker.parla(
                this,
                "Ti ascolto",
                () -> {}
        );
    }

    private void fermaWakeWord() {

        attivo = false;

        if (audioRecord != null) {

            try {
                audioRecord.stop();
            } catch (Exception ignored) {}

            try {
                audioRecord.release();
            } catch (Exception ignored) {}

            audioRecord = null;
        }

        if (stream != null) {

            try {
                stream.release();
            } catch (Exception ignored) {}

            stream = null;
        }

        if (keywordSpotter != null) {

            try {
                keywordSpotter.release();
            } catch (Exception ignored) {}

            keywordSpotter = null;
        }
    }

    private void creaCanaleNotifica() {

        if (Build.VERSION.SDK_INT >=
                Build.VERSION_CODES.O) {

            NotificationChannel canale =
                    new NotificationChannel(
                            CHANNEL_ID,
                            "Lisa Voice",
                            NotificationManager
                                    .IMPORTANCE_LOW
                    );

            NotificationManager manager =
                    getSystemService(
                            NotificationManager.class
                    );

            manager.createNotificationChannel(
                    canale
            );
        }
    }

    private Notification creaNotifica(
            String testo) {

        Intent intent =
                new Intent(
                        this,
                        MainActivity.class
                );

        PendingIntent pendingIntent =
                PendingIntent.getActivity(
                        this,
                        0,
                        intent,
                        PendingIntent.FLAG_IMMUTABLE
                );

        return new Notification.Builder(
                this,
                CHANNEL_ID
        )
                .setContentTitle("Lisa")
                .setContentText(testo)
                .setSmallIcon(
                        android.R.drawable
                                .ic_btn_speak_now
                )
                .setOngoing(true)
                .setContentIntent(pendingIntent)
                .build();
    }

    @Override
    public void onDestroy() {

        fermaWakeWord();

        Log.i(
                TAG,
                "Lisa Voice Core arrestato"
        );

        super.onDestroy();
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }
}
